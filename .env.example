# Application mode: development, test, or production.
APP_ENV=development
LOG_LEVEL=INFO

# Demo mode is explicit. It permits local fixtures when live integrations are absent.
DEMO_MODE=true

# Configure these when a model provider is selected. Do not commit a real key.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Leave unset until Langfuse is deliberately enabled.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
