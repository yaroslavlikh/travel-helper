# Application mode: development, test, or production.
APP_ENV=development
LOG_LEVEL=INFO

# Demo mode is explicit. It permits local fixtures when live integrations are absent.
DEMO_MODE=true
CHECKPOINT_DB_PATH=.data/travel-helper.sqlite3
PLACES_DATABASE_URL=postgresql://travel:travel@127.0.0.1:5433/travel_places
PLACES_EMBEDDING_VERSION=hash-v1
AVIASALES_MARKER=

# Configure these when a model provider is selected. Do not commit a real key.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=2048

# Leave unset until Langfuse is deliberately enabled.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_CAPTURE_CONTENT=false
