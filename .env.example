# Application mode: development, test, or production.
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated hostnames. Production rejects wildcards and local-only defaults.
TRUSTED_HOSTS=localhost,127.0.0.1
# Leave blank for same-origin frontend. Any production origin must start with https://.
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Demo mode is explicit. It permits local fixtures when live integrations are absent.
DEMO_MODE=true
CHECKPOINT_DB_PATH=.data/travel-helper.sqlite3
ACCOUNT_DB_PATH=.data/travel-accounts.sqlite3
# Required in staging and production. Use Render's Internal Database URL; never commit a real value.
DATABASE_URL=
PLACES_DATABASE_URL=postgresql://travel:travel@127.0.0.1:5433/travel_places
PLACES_EMBEDDING_VERSION=hash-v1
AVIASALES_MARKER=
# Travelpayouts Data API credentials. Keep real values in .env or the hosting secret manager.
TRAVELPAYOUTS_API_TOKEN=
TRAVELPAYOUTS_PARTNER_ID=

# Configure these when a model provider is selected. Do not commit a real key.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=2048

# Complete Langfuse credentials enable tracing automatically. Set LANGFUSE_ENABLED=false to opt out.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_CAPTURE_CONTENT=false

# Optional account sync. Leave incomplete to keep login disabled while guest mode remains available.
OIDC_ISSUER=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
# Generate at least 32 random characters and keep them in a secret manager in production.
AUTH_SESSION_SECRET=

# Local email/password login is enabled by default for development. Production requires the secret above.
PASSWORD_AUTH_ENABLED=true
